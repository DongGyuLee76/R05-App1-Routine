@echo off
chcp 65001 >nul
setlocal enabledelayedexpansion

echo ============================================================
echo [시작] 로컬 폴더 - GitHub 리포지토리 완전 동기화 스크립트
echo ============================================================

:: 1. Git 저장소 검증
if not exist .git (
    echo [에러] 현재 폴더는 Git 리포지토리가 아닙니다.
    goto END
)

:: 2. 기존 임시 파일 정리 및 LFS 설정 (이전 단계 수행)
echo [1/4] Git LFS 및 시스템 환경 점검...
git lfs install

:: 3. 로컬 폴더의 모든 변동사항을 강제로 스테이징 영역에 추가
echo [2/4] 로컬 폴더 내 모든 신규/수정 파일 스캔 및 스테이징...
git add .

:: 4. 현재 상태를 커밋으로 기록 (변동사항이 없을 때 발생하는 스킵 처리 포함)
echo [3/4] 동기화 스냅샷 커밋 생성 중...
set "COMMIT_MSG=로컬 폴더 완전 동기화 (%date% %time%)"
git commit -m "%COMMIT_MSG%" >nul 2>&1
if %errorlevel% equ 0 (
    echo       -&gt; 새로운 변경 사항이 커밋되었습니다.
) else (
    echo       -&gt; [안내] 새롭게 변경된 파일은 없습니다. 기존 상태로 동기화를 진행합니다.
)

:: 5. GitHub 원격 저장소로 완전 동기화 (Push 파이프라인)
echo [4/4] GitHub 리포지토리 전송 및 최종 동기화 개시...
echo ------------------------------------------------------------
echo [선택] LFS 히스토리 개편으로 인해 푸시가 거부될 수 있습니다.
echo        1. 일반 푸시 (안전한 기본 동기화)
echo        2. 강제 푸시 (원격 저장소를 로컬 상태와 100%% 똑같이 덮어씀)
echo ------------------------------------------------------------
set /p CHOICE="실행할 동기화 번호를 입력하세요 (1 또는 2): "

if "%CHOICE%"=="2" (
    echo [경고] 원격 GitHub 저장소의 데이터를 현재 로컬 기준으로 강제 리셋합니다...
    git push origin main --force
) else (
    echo [진행] 일반 동기화를 시도합니다...
    git push origin main
)

if %errorlevel% equ 0 (
    echo ============================================================
    echo [성공] 로컬 폴더와 GitHub 리포지토리가 완벽히 동기화되었습니다!
    echo ============================================================
) else (
    echo ============================================================
    echo [실패] 동기화 중 에러가 발생했습니다. (원격 저장소 권한 혹은 충돌 가능성)
    echo        일반 푸시(1번) 실패 시 강제 푸시(2번)를 시도해 보세요.
    echo ============================================================
)

:END
endlocal
pause